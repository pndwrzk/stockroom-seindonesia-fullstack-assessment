        "tags": ["Store Stocks"],
        "summary": "Delete store stock",
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/stock-opnames/count": {
      "get": {
        "tags": ["Stock Opnames"],
        "summary": "Count stock opnames by status",
        "description": "OWNER receives global counts. MANAGER and STAFF receive counts scoped to their own store. Status: 0 INITIATED, 1 IN_PROGRESS, 2 SUBMITTED, 3 APPROVED, 4 REJECTED.",
        "responses": {
          "200": {
            "description": "Counts for every status",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/StatusCount" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/stock-opnames": {
      "get": {
        "tags": ["Stock Opnames"],
        "summary": "List stock opnames",
        "description": "OWNER sees all opnames; MANAGER and STAFF are scoped to their own store.",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "integer", "enum": [0, 1, 2, 3, 4] }
          },
          {
            "name": "storeId",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive partial search by session number.",
            "schema": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated stock opname list",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/StockOpnameListItem" }
                        },
                        "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "post": {
        "tags": ["Stock Opnames"],
        "summary": "Initiate stock opname",
        "description": "OWNER or MANAGER. MANAGER can initiate only for their own store.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StockOpnameInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stock opname initiated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StockOpnameCreateResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/stock-opnames/{id}/item": {
      "parameters": [{ "$ref": "#/components/parameters/UuidId" }],
      "get": {
        "tags": ["Stock Opnames"],
        "summary": "List items in stock opname",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Paginated item list, product includes unit",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/StockOpnameItem" }
                        },
                        "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/stock-opnames/{id}/items/submit": {
      "parameters": [{ "$ref": "#/components/parameters/UuidId" }],
      "patch": {
        "tags": ["Stock Opnames"],
        "summary": "Submit counted quantities",
        "description": "Route middleware currently permits STAFF. Multiple products can be submitted at once. Optional note is recorded in history. First submission changes status to IN_PROGRESS; when every item has countedQty, status changes to SUBMITTED. REJECTED opnames can be resubmitted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubmitStockOpnameItemsInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Counted quantities submitted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubmitStockOpnameItemsResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/stock-opnames/{id}/approve": {
      "parameters": [{ "$ref": "#/components/parameters/UuidId" }],
      "post": {
        "tags": ["Stock Opnames"],
        "summary": "Approve stock opname",
        "description": "OWNER or MANAGER; MANAGER can review only opnames for their own store. Only SUBMITTED opnames can be approved. Approval updates store stock quantities from countedQty.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReviewInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stock opname approved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StockOpnameResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/stock-opnames/{id}/reject": {
      "parameters": [{ "$ref": "#/components/parameters/UuidId" }],
      "post": {
        "tags": ["Stock Opnames"],
        "summary": "Reject stock opname",
        "description": "OWNER or MANAGER; MANAGER can review only opnames for their own store. Only SUBMITTED opnames can be rejected.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReviewInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stock opname rejected",
            "content": {
              "application/json": {
