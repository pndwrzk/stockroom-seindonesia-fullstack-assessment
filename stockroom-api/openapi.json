      "parameters": [{ "$ref": "#/components/parameters/UuidId" }],
      "get": {
        "tags": ["Stock Opnames"],
        "summary": "Get stock opname detail",
        "description": "Returns the opname, store, initiator, and status history. Items are available from the paginated /item endpoint.",
        "responses": {
          "200": {
            "description": "Stock opname detail with history",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StockOpnameResponse" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "tags": ["Stock Opnames"],
        "summary": "Delete stock opname",
        "description": "OWNER only. Deletion is allowed only for INITIATED, REJECTED, or APPROVED status.",
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "403": { "$ref": "#/components/responses/Forbidden" },
